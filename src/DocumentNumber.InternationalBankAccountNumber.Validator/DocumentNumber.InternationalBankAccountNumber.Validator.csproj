<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <AssemblyName>DocumentNumber.InternationalBankAccountNumber.Validator</AssemblyName>
    <PackageId>DocumentNumber.InternationalBankAccountNumber.Validator</PackageId>
    <Title>DocumentNumber.InternationalBankAccountNumber.Validator</Title>
    <Description>A library that validates if the International Bank Account number (IBAN) is valid or not.</Description>
    <PackageTags>Document Number Validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="iban-lengths.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocumentNumber.ValidatorAbstractions\DocumentNumber.ValidatorAbstractions.csproj" />
  </ItemGroup>



</Project>
